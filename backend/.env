# ── Connector Framework (Google Drive) ────────────────────────────────────────
# NOTE: Reuses existing OAUTH_GOOGLE_CLIENT_ID / OAUTH_GOOGLE_CLIENT_SECRET
# automatically. Only set CONNECTOR_GOOGLE_DRIVE_* if you want separate creds.
# CONNECTOR_GOOGLE_DRIVE_CLIENT_ID=
# CONNECTOR_GOOGLE_DRIVE_CLIENT_SECRET=
CONNECTOR_GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/connectors/google-drive/callback
# CONNECTOR_GOOGLE_DRIVE_WEBHOOK_URL=  # Set to your public HTTPS URL (e.g. ngrok) to enable webhooks

# Celery (uses existing Redis on separate DB indices to avoid conflicts)
CONNECTOR_CELERY_BROKER_URL=redis://localhost:6379/1
CONNECTOR_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auto-sync interval for connected Drive accounts (minutes)
CONNECTOR_DEFAULT_SYNC_INTERVAL_MINUTES=30
