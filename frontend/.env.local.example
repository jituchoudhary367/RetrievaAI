# Frontend environment variables

# URL of the FastAPI backend (default: local dev)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Maximum context window size displayed in the ConversationContextPanel token usage bar.
# Should match the context limit of your configured LLM model.
# GPT-4o: 128000, GPT-4-turbo: 128000, GPT-3.5-turbo: 16384, Claude 3.5: 200000
NEXT_PUBLIC_MAX_CONTEXT_TOKENS=16384
